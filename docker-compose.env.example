# Copy to .env beside docker-compose.yml before starting Playblast.
# Never commit .env to version control.

# Required in production — generate a random string at least 32 characters long.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: session lifetime in hours (default 168 / 7 days)
# SESSION_TTL_HOURS=168

# Optional: operator recovery token for lost admin credentials (store securely).
# PLAYBLAST_ADMIN_RECOVERY_TOKEN=replace-with-a-long-random-recovery-token

# Optional emergency bootstrap Basic Auth before first-run setup completes.
# Normal application access uses Playblast login sessions instead.
# PLAYBLAST_EMERGENCY_BASIC_AUTH=false
# PLAYBLAST_AUTH_USER=
# PLAYBLAST_AUTH_PASSWORD=
