# Copy to .env beside docker-compose.yml before starting Playblast.
# Never commit .env to version control.

# Required in production — generate a random string at least 32 characters long.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: session lifetime in hours (default 168 / 7 days)
# SESSION_TTL_HOURS=168

# Optional: operator recovery token for lost admin credentials (store securely).
# PLAYBLAST_ADMIN_RECOVERY_TOKEN=replace-with-a-long-random-recovery-token

# Optional emergency bootstrap Basic Auth before first-run setup completes.
# Normal application access uses Playblast login sessions instead.
# PLAYBLAST_EMERGENCY_BASIC_AUTH=false
# PLAYBLAST_AUTH_USER=
# PLAYBLAST_AUTH_PASSWORD=

# Optional: public/LAN hostname when using docker-compose.proxy.yml (Caddy).
# PLAYBLAST_DOMAIN=playblast.example.com

# Optional SMTP (12-factor). When ALL required vars below are set, Team UI SMTP is read-only.
# Required: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp-user
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=noreply@example.com
# SMTP_REPLY_TO=support@example.com
# PLAYBLAST_INSTANCE_URL=https://playblast.example.com

# Trusted reverse-proxy hop count (default 0). The proxy overlay sets PROXY_HOPS=1.
# Only raise above 1 if you have additional trusted proxies in front of Caddy/nginx.
# PROXY_HOPS=0

