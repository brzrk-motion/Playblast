# Copy to .env beside docker-compose.synology.yml on the NAS.
# Never commit .env to version control.

# Required — random string at least 32 characters.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional bind-mount paths (defaults match /volume1/docker/playblast/ layout).
# PLAYBLAST_DATA_DIR=/volume1/docker/playblast/data
# PLAYBLAST_UPLOADS_DIR=/volume1/docker/playblast/uploads

# Optional host port when 3000 is taken (maps host:container).
# PLAYBLAST_HOST_PORT=3001

# Optional session lifetime in hours (default 168 / 7 days).
# SESSION_TTL_HOURS=168

# Optional operator recovery token (store securely).
# PLAYBLAST_ADMIN_RECOVERY_TOKEN=

# When terminating TLS at DSM reverse proxy, set PROXY_HOPS=1.
# PROXY_HOPS=0

# Max upload size in MB (default 5000). Align reverse-proxy body limits with this value.
# MAX_UPLOAD_SIZE=5000
