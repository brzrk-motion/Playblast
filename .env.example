# Playblast environment configuration
# Copy to .env at the repo root: cp .env.example .env
# Never commit .env to version control.
#
# Server variables are read at runtime (Express loads this file via dotenv).
# Client VITE_* variables are read by Vite at dev/build time.

# --- Server ---

# Server port (default: 3000)
PORT=3000

# Listen address (default: 0.0.0.0 — required for Docker port publish).
# Do not set HOST=127.0.0.1 in Compose/containers: published ports become unreachable from the host.
HOST=0.0.0.0

# Runtime environment: production or development (default: development)
NODE_ENV=development

# Trusted reverse-proxy hop count for Express (default: 0 = do not trust X-Forwarded-*).
# Set to 1 when using docker-compose.proxy.yml (Caddy/nginx is the only trusted forwarder).
# PROXY_HOPS=0

# Absolute path to uploads directory (default: /app/uploads)
# For local development, use a path inside the repo:
# UPLOAD_DIR=/absolute/path/to/playblast/server/uploads
UPLOAD_DIR=/app/uploads

# Absolute path to the SQLite database file (default: /app/data/playblast.db)
# For local development, use a path inside the repo:
# DB_PATH=/absolute/path/to/playblast/server/data/playblast.db
DB_PATH=/app/data/playblast.db

# Maximum upload size in megabytes (default: 5000)
MAX_UPLOAD_SIZE=5000

# Application session signing secret (required in production; 32+ characters)
# SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Session lifetime in hours (default: 168 / 7 days)
# SESSION_TTL_HOURS=168

# Optional emergency bootstrap Basic Auth before first-run setup completes.
# Normal application access uses Playblast sessions instead.
# When enabled in production, PLAYBLAST_AUTH_USER and PLAYBLAST_AUTH_PASSWORD are required.
# PLAYBLAST_EMERGENCY_BASIC_AUTH=false
# PLAYBLAST_AUTH_USER=pilot
# PLAYBLAST_AUTH_PASSWORD=replace-with-a-long-random-password

# Operator recovery token for lost admin credentials (no plaintext password storage).
# PLAYBLAST_ADMIN_RECOVERY_TOKEN=replace-with-a-long-random-recovery-token

# SMTP transport (12-factor). When all required vars below are set, the server treats
# SMTP as preconfigured from the environment (smtpConfiguredFromEnv=true) and Admin UI
# SMTP settings are ignored.
# Required for env-based SMTP: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS, SMTP_FROM
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=smtp-user
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=noreply@example.com
# SMTP_REPLY_TO=support@example.com

# Public URL for this Playblast instance (used in invitation links when SMTP is env-preconfigured).
# PLAYBLAST_INSTANCE_URL=https://playblast.example.com

# Mailpit catcher API URL for development/CI only (e.g. http://localhost:8025).
# Ignored when NODE_ENV=production.
# MAILPIT_URL=http://localhost:8025

# --- Client (Vite) ---

# Default video frame rate when FPS cannot be detected (default: 24).
# Baked into the client bundle at build time; restart dev server or rebuild after changing.
# VITE_DEFAULT_VIDEO_FPS=24
