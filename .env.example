# Server port (default: 3000)
PORT=3000

# Absolute path to uploads directory (default: /app/uploads)
# For local development, use a path inside the repo:
# UPLOAD_DIR=/absolute/path/to/playblast/server/uploads
UPLOAD_DIR=/app/uploads

# Maximum upload size in megabytes (default: 5000)
MAX_UPLOAD_SIZE=5000

# Runtime environment: production or development (default: development)
NODE_ENV=development

# Default video frame rate when FPS cannot be detected (default: 24)
# VITE_DEFAULT_VIDEO_FPS=24
